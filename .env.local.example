# Sanity environment variables — copy this file to .env.local and fill in values.
#
#   cp .env.local.example .env.local
#
# Find Project ID and create API tokens at https://www.sanity.io/manage

# Your Sanity project ID (Project settings → API)
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"

# Dataset name — "production" by default
NEXT_PUBLIC_SANITY_DATASET="production"

# API version, pinned to a date (YYYY-MM-DD). Bump deliberately when adopting new API behavior.
NEXT_PUBLIC_SANITY_API_VERSION="2026-06-30"

# Optional: read token for drafts/preview (Visual Editing). Viewer role.
# Leave blank if you only fetch published content.
SANITY_API_READ_TOKEN=""

# Contact form delivery (/contact).
# Where a submission is POSTed as JSON — a Slack incoming webhook, a Zapier or
# Make catch hook, or an internal endpoint. Deliberately not tied to an email
# provider so no vendor SDK or extra secret is needed.
# Unset, the form validates and then tells the sender to email us directly
# instead of silently swallowing the message.
CONTACT_WEBHOOK_URL=""

# Design system playground (/playground).
# Always on in development. In production the route 404s unless this is "true" —
# set it on a preview deployment to share it, leave it unset on production.
ENABLE_PLAYGROUND=""
