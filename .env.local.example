# Sanity environment variables — copy this file to .env.local and fill in values.
#
#   cp .env.local.example .env.local
#
# Find Project ID and create API tokens at https://www.sanity.io/manage

# Your Sanity project ID (Project settings → API)
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"

# Dataset name — "production" by default
NEXT_PUBLIC_SANITY_DATASET="production"

# API version, pinned to a date (YYYY-MM-DD). Bump deliberately when adopting new API behavior.
NEXT_PUBLIC_SANITY_API_VERSION="2026-06-30"

# Optional: read token for drafts/preview (Visual Editing). Viewer role.
# Leave blank if you only fetch published content.
SANITY_API_READ_TOKEN=""

# Shared secret for the Sanity publish webhook that refreshes pages at once
# (app/api/revalidate/route.ts). Any long random string; paste the same value
# into the webhook's "Secret" field at sanity.io/manage.
SANITY_REVALIDATE_SECRET=""

# Server-only write token (Editor role) — lets the Contact form save messages
# to Sanity's Inbox. Create with: npx sanity tokens add "Website forms" --role=editor
SANITY_API_WRITE_TOKEN=""

# Contact form email via Resend (resend.com). Without a key, messages are only
# saved to Sanity. CONTACT_FROM_EMAIL must be on a domain verified in Resend,
# e.g. "Softcom website <website@softcom.xyz>"; the default onboarding@resend.dev
# can only deliver to the Resend account owner's own address.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
